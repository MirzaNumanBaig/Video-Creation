    {
      "id": "seo-work",
      "from": "seo-desk",
      "to": "xplorekit",
      "via": "work branch + tools/gate.py, then PR",
      "status": "live"
    },
    {
      "id": "news-to-wordpress",
      "from": "researcher-agents",
      "to": "wordpress:modus-carry",
      "via": "approved articles/*.md published by publish_wordpress.py",
      "status": "live"
    },
    {
      "id": "seo-engine-to-blog",
      "from": "content-creation-agency",
      "to": "wordpress:client-blogs",
      "via": "Herald publisher, default status pending",
      "status": "live"
    },
    {
      "id": "articles-to-video",
      "from": "researcher-agents",
      "to": "clips-studio",
      "via": "approved article -> script/voiceover -> clip or reel",
      "status": "proposed"
    },
    {
      "id": "directory-to-pins",
      "from": "xplorekit",
      "to": "pin-creator",
      "via": "directory page URL -> pin",
      "status": "proposed"
    },
    {
      "id": "seo-feedback",
      "from": "seo-desk",
      "to": "content-creation-agency",
      "via": "strategy.md keyword clusters -> briefs",
      "status": "proposed"
    },
    {
      "id": "script-to-reel",
      "from": "instagram-agent-skill",
      "to": "reel-studio-kit",
      "via": "ig-reel script/hook -> projects/<id>/voice.txt (after owner approval)",
      "status": "proposed"
    },
    {
      "id": "reel-to-post",
      "from": "reel-studio-kit",
      "to": "instagram-agent-skill",
      "via": "out/<id>.mp4 -> ig-caption / ig-human -> owner posts",
      "status": "proposed"
    },
    {
      "id": "long-to-shorts",
      "from": "youtube-agent-skill",
      "to": "clips-studio",
      "via": "yt-shorts picks moments -> clips-studio renders clips",
      "status": "proposed"
    },
    {
      "id": "humanize-writers",
      "from": "instagram-agent-skill",
      "to": "researcher-agents",
      "via": "ig-human humanize.py as a pre-publish pass on drafts",
      "status": "proposed"
    }
  ],
